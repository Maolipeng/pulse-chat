{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env*",
    "**/next.config.*",
    "**/jsconfig.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SOCKET_URL",
    "NEXT_PUBLIC_STUN_URLS",
    "NEXT_PUBLIC_TURN_URLS",
    "NEXT_PUBLIC_TURN_USERNAME",
    "NEXT_PUBLIC_TURN_CREDENTIAL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "apps/client/.next/**",
        "apps/client/dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    }
  }
}
